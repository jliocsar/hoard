{
  "$schema": "http://json.schemastore.org/package",
  "name": "hoard",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.1.2",
      "@effect/platform-node": "4.1.2",
      "@effect/sql-sqlite-bun": "4.1.2",
      "effect": "4.1.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter '@hoard/web' dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --disable-nested-config",
    "lint:fix": "oxlint --fix --deny-warnings --disable-nested-config",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "prepare": "effect-tsgo patch --oxlint",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@jliocsar/begone-slop": "^0.2.11",
    "@types/bun": "^1.3.14",
    "effect": "catalog:",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
