{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
    "./node_modules/@effect/tsgo/oxlint-presets/correctness.json",
    "./node_modules/@effect/tsgo/oxlint-presets/antipattern.json",
    "./node_modules/@jliocsar/begone-slop/preset.json"
  ],
  "plugins": ["typescript", "promise", "effecttsgo", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error"
  },
  "ignorePatterns": ["**/*.d.ts", "**/dist/**", "**/public/**", ".agents/**", ".claude/**"],
  "jsPlugins": ["@jliocsar/begone-slop"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^effect(/[a-z][a-z0-9-]*)?$",
            "allowTypeImports": true,
            "message": "Import the leaf module, not the barrel: `effect/Effect`, `effect/Schema`."
          }
        ]
      }
    ],

    // Their quickfixes write `Effect.asVoid` and a log-less `Effect.ignore`, which begone-slop rejects.
    "effecttsgo/effect-map-void": "off",
    "effecttsgo/catch-to-ignore": "off",
    // Native string and array methods read fine; `effect/String` and `effect/Array` are for
    // what native lacks, not a rewrite of what it has.
    "effecttsgo/prefer-effect-string": "off",
    "effecttsgo/prefer-effect-array": "off",
    // `JSON.stringify` on plain data outside an Effect can't fail; inside one, `global-json-in-effect`
    // still asks for a Schema codec.
    "effecttsgo/global-json": "off",
    // A schema's derived type shares the schema's name, which this rule reads as a redeclaration.
    // The compiler still rejects a real one.
    "no-redeclare": "off",

    // Off until oxc stops treating a namespace import as a possible Promise: it reports every
    // `Effect.catch` and `Stream.catch` that isn't under a `yield` or `await`. `effect-native`
    // keeps Promises out of Effect code, so there's no real chain for it to catch.
    "promise/prefer-await-to-then": "off",

    // The environment is read through `Config`, once, in the `make` of the
    // service that needs it.
    "node/no-process-env": "error",

    "id-length": [
      "error",
      {
        "min": 2,
        "exceptions": ["i", "j"],
        "properties": "never"
      }
    ],
    "no-else-return": [
      "error",
      {
        "allowElseIf": false
      }
    ],
    "no-nested-ternary": "error",
    "prefer-template": "error",
    "complexity": ["error", 15],
    "max-classes-per-file": "off",
    "max-lines": ["error", 1000],
    "max-lines-per-function": [
      "error",
      {
        "max": 200,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "require-yield": "off",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/array-type": [
      "error",
      {
        "default": "array",
        "readonly": "array"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true,
        "allowBoolean": true
      }
    ]
  },
  "overrides": [
    {
      // Encryption at rest stays on `node:crypto` for now. `seal` runs synchronously inside SQL
      // templates and `effect/crypto`'s AES-GCM only runs on `crypto.subtle`, which is async, and
      // lays bytes out differently from the rows already stored. Moving is a rewrite, not a swap.
      // The session signature compare stays too: `Mac.timingSafeEqual` is a loop in JavaScript and
      // its docs don't promise constant time, where `node:crypto`'s is native.
      "files": ["apps/web/src/services/Cipher.ts", "apps/web/src/services/Auth.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/test/**/*.ts"],
      "rules": {
        "begone-slop/expect-padding": "error",
        "max-lines-per-function": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-unnecessary-type-conversion": "off"
      }
    }
  ]
}
